# Template for Hardhat environment variables.
# Copy this file to .env and fill in the values.

# Chain selection -- the ONLY chain-selection input. Everything else derives from this string.
# Supported values: base, baseSepolia, arbitrum, optimism, ethereum
CHAIN=base

# Scaffold-ETH 2's Alchemy integration. A shared default key is included and works out of the box.
# Set your own key for production to avoid rate limits.
ALCHEMY_API_KEY=

# Block explorer API key for contract verification.
ETHERSCAN_V2_API_KEY=

# Admin wallet address. Set before a live deploy so ownership is transferred immediately.
# Leave blank on local dev -- the deployer retains ownership for testing.
ADMIN_WALLET=

# Do not fill this manually. Run yarn account:generate or yarn account:import.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=
